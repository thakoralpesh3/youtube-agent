# ==============================================================================
# YouTube Automation Agent Configuration Template
# ==============================================================================
# Rename this file to .env and insert your API keys and configuration settings.

# 1. Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-argon
GEMINI_IMAGEN_MODEL=imagen-3.0-generate-002

# 2. YouTube Data API v3 Configuration
# Path to your OAuth 2.0 client credentials JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=output/token.json

# Video Privacy Status: "public", "unlisted", or "private"
YOUTUBE_PRIVACY_STATUS=public

# 3. Content Niche & Scheduling
DEFAULT_NICHE=High-Performance Growth Mindset, Stoic Philosophy, Health & Fitness Science, Mental Resilience, and Peak Daily Discipline
YOUTUBE_CATEGORY_ID=27
DAILY_UPLOAD_TIME=09:00

# 4. Text-to-Speech (TTS) Settings
# Deep & Authoritative Voices: en-US-ChristopherNeural, en-US-GuyNeural, en-US-BrianNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
